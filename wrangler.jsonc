{
  // IMPORTANT: this must exactly match the name of the existing Cloudflare
  // project this repo is connected to (Workers & Pages → your project →
  // Settings → General). If your project has a different name, change
  // this to match it before pushing, or the build may fail or deploy to
  // the wrong project.
  "name": "plotbench-site",
  "compatibility_date": "2026-07-28",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
